{
  "name": "drenas-rentacar",
  "version": "1.0.0",
  "private": true,
  "description": "Premium Rent-a-Car platform for Drenas, Kosovo",
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:all": "concurrently -n express,next,dotnet -c blue,green,magenta \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:dotnet\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:dotnet": "node --env-file=server/.env scripts/dev-dotnet.mjs",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose down",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "db:migrate": "cd server && npm run db:migrate",
    "db:seed": "cd server && npm run db:seed",
    "db:reset": "cd server && npm run db:reset"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
