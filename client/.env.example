# Copy to .env.local (or run `npm run setup` in the repo root).

# Option A: call the Express API directly (no rewrites).
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Option B: call /api/v1 on this site and let Next.js forward each route to the
# backend that owns it. Routes listed in DOTNET_ROUTE_GROUPS (next.config.ts)
# go to the .NET API when DOTNET_API_URL is set; everything else goes to Express.
NEXT_PUBLIC_API_URL=/api/v1
EXPRESS_API_URL=http://localhost:4000
DOTNET_API_URL=http://localhost:5080

NEXT_PUBLIC_SITE_URL=http://localhost:3000
