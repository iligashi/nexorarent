# Database
DB_HOST=localhost
DB_PORT=3307
DB_NAME=drenas_rentacar
DB_USER=nexorarent
DB_PASSWORD=replace_with_a_generated_password
# Production only: configure a separate, least-privilege migration account.
# MIGRATION_DB_USER=replace_with_a_distinct_migration_user
# MIGRATION_DB_PASSWORD=replace_with_a_different_generated_password

# JWT
JWT_SECRET=your_64_char_random_secret_here
JWT_REFRESH_SECRET=another_64_char_random_secret_here

# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:3001
COOKIE_SAME_SITE=lax

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local-only Docker Compose database credentials. Generate separate values and
# use MYSQL_PASSWORD as DB_PASSWORD in server/.env.
MYSQL_PORT=3307
MYSQL_DATABASE=drenas_rentacar
MYSQL_USER=nexorarent
MYSQL_PASSWORD=replace_with_a_generated_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_generated_password

# Production application services
# REDIS_URL=rediss://...
# OBJECT_STORAGE_BUCKET=your-media-bucket
# OBJECT_STORAGE_REGION=your-region
# OBJECT_STORAGE_PUBLIC_URL=https://media.example.com
# OBJECT_STORAGE_ENDPOINT=https://s3-compatible.example.com
# OBJECT_STORAGE_FORCE_PATH_STYLE=false
